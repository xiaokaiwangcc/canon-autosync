#!/bin/bash
set -u

APP_DIR="$TRIM_APPDEST/backend"
VENV="$APP_DIR/.venv"
LOGFILE="$TRIM_PKGVAR/app.log"

export PATH="/var/apps/python312/target/bin:$PATH"

mkdir -p "$TRIM_PKGVAR"

if [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c "import fastapi, uvicorn, httpx, pydantic" 2>/dev/null; then
  exit 0
fi

if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV" >>"$LOGFILE" 2>&1 || {
    echo "Python 虚拟环境创建失败" > "$TRIM_TEMP_LOGFILE"
    exit 1
  }
fi

PIP="$VENV/bin/pip"
REQ="$APP_DIR/requirements.txt"
OPTS="--no-cache-dir --timeout 15 --disable-pip-version-check"

if ! "$PIP" install $OPTS -i https://pypi.tuna.tsinghua.edu.cn/simple -r "$REQ" >>"$LOGFILE" 2>&1; then
  "$PIP" install $OPTS -r "$REQ" >>"$LOGFILE" 2>&1 || {
    echo "依赖安装失败，请检查 NAS 网络连接" > "$TRIM_TEMP_LOGFILE"
    exit 1
  }
fi
exit 0
